# Copy to .env.local and fill in from your Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only. NEVER expose in client code or commit to git.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Your production URL (used for sitemap/SEO/emails)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Billing (Stripe) — optional until you turn on monetization ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FEATURED=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

# --- Additional billing config ---
# Currency drives available local methods (brl unlocks PIX + boleto).
BILLING_CURRENCY=usd
# One-time (annual) price IDs — enable PIX/boleto without recurring card.
STRIPE_PRICE_FEATURED_ANNUAL=price_xxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx

# --- Transactional email (Resend) — optional ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=Conecta <no-reply@yourdomain.com>

# --- Notifications / reminders ---
CRON_SECRET=a-long-random-string-for-manual-dispatch
# WhatsApp (optional; connect Twilio / 360dialog / Meta Cloud API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
