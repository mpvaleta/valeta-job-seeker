# Required to open the app at all (see lib/access-auth.ts). Generate at least
# 32 random characters. Never expose this as NEXT_PUBLIC_*.
APP_TOKEN=
# Not a secret — the email APP_TOKEN itself resolves to.
APP_OWNER_EMAIL=you@example.com

# Optional: share access with specific other people without sharing APP_TOKEN.
# Comma-separated "email:token" pairs, each token a distinct random secret
# (its own >=32 random characters) — identity comes from which token a
# request presents, never from a claimed email. Leave blank for solo use.
EXTRA_ACCESS_TOKENS=

# Server-only secret. Never expose this as NEXT_PUBLIC_* or commit a real value.
OPENAI_API_KEY=

# Optional override. V's defaults to the high-reliability model below.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna

# Optional Anthropic Claude connection and allowlisted model overrides.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BALANCED_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Optional Google Gemini connection and allowlisted model overrides.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BALANCED_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite

# Optional extra gate on top of APP_TOKEN/EXTRA_ACCESS_TOKENS, specifically
# for paid cloud AI calls. Comma-separated emails (must already be able to
# authenticate via APP_TOKEN or EXTRA_ACCESS_TOKENS). Leave blank to allow
# only APP_OWNER_EMAIL; set this to also let other authenticated identities
# use cloud AI.
AI_ALLOWED_EMAILS=

# Official LinkedIn OpenID Connect (identity only). Create an app at
# https://www.linkedin.com/developers/apps and enable "Sign In with LinkedIn using OpenID Connect".
# The redirect URI must exactly match your deployed site plus /api/linkedin/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-site.example/api/linkedin/callback
# Generate at least 32 random characters. Never expose this as NEXT_PUBLIC_*.
LINKEDIN_SESSION_SECRET=

# Enables twice-daily background radar scans while the app is closed. Generate
# at least 32 random characters, then have the hosting scheduler (or any cron
# service) call GET or POST /api/radar/cron twice daily with the header
# "Authorization: Bearer <this value>". Leave blank to keep app-open catch-up
# scans only. Never expose this as NEXT_PUBLIC_*.
RADAR_CRON_SECRET=
