{
  "manifest_version": 3,
  "name": "V's Application Autofill",
  "version": "0.7.0",
  "description": "Capture visible job pages and results lists, and preview approved job-application fields. Never submits forms.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "V's Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "autofill-mapping.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
